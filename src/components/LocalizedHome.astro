---
import type { Language } from '../i18n/ui';
import { getUi } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import Header from './Header.astro';
import Projects from './Projects.astro';
import Experiences from './Experiences.astro';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const t = getUi(language);
---

<Layout
  title={t.meta.title}
  description={t.meta.description}
  language={language}
>
  <Header language={language} />
  <main id="top">
    <Hero language={language} />
    <Projects language={language} />
    <Experiences language={language} />
  </main>
  <footer class="site-footer">
    <div class="site-shell footer-inner">
      <div>
        <p class="eyebrow">{t.footer.eyebrow}</p>
        <p class="footer-title">{t.footer.title}</p>
      </div>
      <div class="footer-actions">
        <a class="button button-primary" href="https://www.linkedin.com/in/rubensaizs/" target="_blank" rel="noreferrer">
          {t.footer.conversation} <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="button" href="https://github.com/MiYazJE" target="_blank" rel="noreferrer">{t.footer.github}</a>
      </div>
    </div>
    <div class="site-shell footer-meta">
      <span>{t.footer.signature}</span>
      <a href="#top">{t.footer.backToTop} ↑</a>
    </div>
  </footer>
</Layout>

<style>
  .site-footer {
    margin-top: 8rem;
    padding: 5rem 0 2rem;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .footer-inner {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-title {
    max-width: 18ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
  }

  .footer-meta a:hover {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .site-footer {
      margin-top: 6rem;
      padding-top: 4rem;
    }

    .footer-inner {
      display: grid;
      align-items: start;
    }

    .footer-actions {
      display: grid;
    }

    .footer-meta {
      gap: 1rem;
      margin-top: 3rem;
    }
  }
</style>
